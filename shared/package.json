{
  "name": "@electro-expert/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, enums, and utilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:robust": "node build-robust.js",
    "build:force": "npm run clean && npm run build:robust",
    "dev": "tsc --watch",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "clean": "rimraf dist",
    "type:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "rimraf": "^6.0.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
